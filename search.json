---
layout: null
permalink: /search.json
---
{%- assign docs = site.pages | where_exp: "p", "p.path contains 'pages/'" | sort: "path" -%}
[
{%- for p in docs -%}
{%- assign html = p.content | markdownify | replace: '<h3 id="', '<h2 id="' | replace: '</h3>', '</h2>' | split: '</h1>' | last -%}
{%- assign parts = html | split: '<h2 id="' -%}
{"t":{{ p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"s":[
{%- for part in parts -%}
{%- if forloop.first -%}
{%- assign anchor = "" -%}{%- assign head = "" -%}{%- assign body = part -%}
{%- else -%}
{%- assign anchor = part | split: '"' | first -%}
{%- assign split_head = part | split: '</h2>' -%}
{%- assign head = split_head | first | remove_first: anchor | remove_first: '">' | split: '<kbd>' | first | strip_html | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' | normalize_whitespace | strip -%}
{%- assign body = part | remove_first: split_head[0] | remove_first: '</h2>' -%}
{%- endif -%}
{%- assign blocks = body | split: '<div class="language-' -%}
{%- assign text = blocks | first -%}
{%- assign code = "" -%}
{%- for b in blocks offset: 1 -%}
{%- assign lang = b | split: ' ' | first -%}
{%- assign bits = b | split: '</pre></div></div>' -%}
{%- assign src = bits | first | remove_first: lang | remove_first: ' highlighter-rouge">' | strip_html | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' | normalize_whitespace | strip | truncate: 1000, "" -%}
{%- capture one -%}[{{ lang | jsonify }},{{ src | jsonify }}]{%- endcapture -%}
{%- if code != "" -%}{%- assign code = code | append: "," -%}{%- endif -%}
{%- assign code = code | append: one -%}
{%- assign tail = b | remove_first: bits[0] | remove_first: '</pre></div></div>' -%}
{%- assign text = text | append: " " | append: tail -%}
{%- endfor -%}
{%- assign text = text | strip_html | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' | normalize_whitespace | strip | truncate: 1500, "" -%}
{%- unless forloop.first -%},{%- endunless -%}
{"a":{{ anchor | jsonify }},"h":{{ head | jsonify }},"x":{{ text | jsonify }},"k":[{{ code }}]}
{%- endfor -%}
]}{%- unless forloop.last -%},{%- endunless %}
{% endfor -%}
]
